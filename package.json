{
  "name": "gret-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smart contracts for Global Reserve Token (GRET): a basket vault on Ethereum",
  "license": "MIT",
  "author": "Global Reserve contributors",
  "homepage": "https://github.com/global-reserve/gret-contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-reserve/gret-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/global-reserve/gret-contracts/issues"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "hardhat build",
    "compile": "hardhat build",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:coverage": "hardhat test --coverage",
    "test:deep": "hardhat test solidity --test-profile deep",
    "test:fork": "hardhat test nodejs test-fork/GRETVault.mainnet.ts",
    "pilot:rehearse": "MAINNET_RPC_URL=${MAINNET_RPC_URL:-https://ethereum-rpc.publicnode.com} hardhat test nodejs test-fork/GRETVault.pilot.ts",
    "pilot:fork-node": "hardhat node --fork ${MAINNET_RPC_URL:-https://ethereum-rpc.publicnode.com}",
    "pilot": "hardhat run scripts/pilot/server.ts",
    "typecheck": "hardhat build && tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "demo": "hardhat run scripts/deploy-local.ts --network hardhat"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "24.19.0",
    "forge-std": "https://github.com/foundry-rs/forge-std/archive/refs/tags/v1.17.0.tar.gz",
    "hardhat": "3.18.0",
    "solc": "0.8.38",
    "typescript": "7.0.2",
    "viem": "2.57.1"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
